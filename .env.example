# Copier ce fichier en .env.local et remplir ce qui sert.

# Base PostgreSQL (Neon, Supabase…). Vide : base locale PGlite dans .data/pglite.
DATABASE_URL=

# Où envoyer les demandes d'essai du formulaire de la page d'accueil.
# Vide : mode démo, la demande est seulement affichée dans le terminal.
# URL /exec du script integrations/google-sheets/apps-script.gs. Celle du Sheet actuel :
# https://script.google.com/macros/s/AKfycbzhzh17rbCAC7RfuuonYr3Y2nRQ54vumP3HPlgWYJbPT2WJxcbUYAaENUgdNelJlvmqTQ/exec
GOOGLE_SHEETS_WEBHOOK_URL=

# Adresse publique de l'application, si elle diffère de celle vue par le serveur (proxy).
APP_ORIGIN=
