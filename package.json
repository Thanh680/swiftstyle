{
  "name": "swiftstyle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SwiftStyle : widget de recommandation de taille pour les fiches produit des marques e-commerce de mode.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run db:setup && npm run widget:build",
    "dev": "next dev --port 3000",
    "prebuild": "npm run widget:build",
    "build": "next build",
    "start": "next start --port 3000",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "widget:build": "vite build --config vite.widget.config.ts && node scripts/check-widget-size.mjs",
    "widget:watch": "vite build --config vite.widget.config.ts --watch",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx src/lib/db/setup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
